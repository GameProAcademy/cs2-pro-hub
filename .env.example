# ---------------------------------------------------------------------------
# Example environment. COPY the keys, NEVER the values.
# This file is committed on purpose and must therefore contain NO real secret.
# The real `.env` is generated/managed by the platform and is git-ignored.
# ---------------------------------------------------------------------------

# --- Backend (managed automatically) --------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Experimental local browser parser POC (public, default OFF) ----------
VITE_CLIENT_DEM_PARSER_POC_ENABLED=false
# Same-origin reviewed assets only. Keep empty until an exact audited 0.42.0
# binding and binary are available. SHA-256 values are lowercase 64-hex.
VITE_CLIENT_DEM_PARSER_WASM_SCRIPT_URL=
VITE_CLIENT_DEM_PARSER_WASM_BINARY_URL=
VITE_CLIENT_DEM_PARSER_WASM_BINDING_SHA256=
VITE_CLIENT_DEM_PARSER_WASM_BINARY_SHA256=

# --- Demo parser worker (server-only; never expose with VITE_*) ------------
# HTTPS parse endpoint. Token and expected identity stay on the server.
DEMO_PARSER_URL=
DEMO_PARSER_TOKEN=
DEMO_PARSER_EXPECTED_NAME=
DEMO_PARSER_EXPECTED_VERSION=
DEMO_PARSER_EXPECTED_REVISION=
# Revision lock override. Default: required in production, optional elsewhere.
DEMO_PARSER_REVISION_REQUIRED=
# Expected shape (no real values here):
#   DEMO_PARSER_URL=https://<worker-host>/v1/parse
#   DEMO_PARSER_EXPECTED_NAME=demoparser2
#   DEMO_PARSER_EXPECTED_VERSION=0.42.0
#   DEMO_PARSER_EXPECTED_REVISION=git:<immutable-worker-commit-sha>
#   DEMO_PARSER_REVISION_REQUIRED=true
#
# Worker side (services/cs2-demo-parser, configured on Railway — NOT here):
#   PARSER_TOKEN=<same secret as DEMO_PARSER_TOKEN>
#   PARSER_REVISION=git:<immutable-worker-commit-sha>
#   PARSER_CONTRACT_VERSION=1
#   ENVIRONMENT=production
#   MAX_DEMO_BYTES=1610612736
#   MAX_PAYLOAD_BYTES=8388608
#   DOWNLOAD_TIMEOUT_SECONDS=120
#   PARSE_TIMEOUT_SECONDS=240
#
# Durable queue bridge (same secret on APP and Railway):
DEMO_PIPELINE_BRIDGE_SECRET=
# Railway-only consumer configuration:
#   DEMO_PIPELINE_BRIDGE_URL=https://gamepro.network/api/public/pipeline-worker
#   DEMO_PIPELINE_BRIDGE_SECRET=<same secret as APP>
#   DEMO_PIPELINE_WORKER_ID=railway-parser-1
#   DEMO_QUEUE_POLL_SECONDS=5
#   DEMO_QUEUE_HEARTBEAT_SECONDS=60

# --- Transactional email — Hostinger Mail API (server-only) ---------------
# Only `hostinger` is supported. Unset = no delivery (honest `not_configured`).
# There is NO SMTP transport: Cloudflare Workers cannot open a raw TCP socket.
EMAIL_PROVIDER=
HOSTINGER_MAIL_API_TOKEN=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=

# --- FACEIT integration (server-only) -------------------------------------
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
FACEIT_API_KEY=
FACEIT_OAUTH_REDIRECT_URI=

# --- FASE 2.5 — Steam identity linking (server-only) ----------------------
# Master switch. DEFAULT OFF: with anything other than true/1/yes/on the
# integration stays dark even if every value below is set.
STEAM_INTEGRATION_ENABLED=
# Public origin of the app. OpenID 2.0 requires HTTPS (localhost allowed in dev).
STEAM_OPENID_REALM=
# Must live INSIDE the realm, and point at this exact route:
#   /api/public/integrations/steam/callback
STEAM_OPENID_RETURN_URL=
# Optional. Defaults to https://steamcommunity.com/openid/login
STEAM_OPENID_ENDPOINT=
# OPTIONAL. Only enables PUBLIC profile enrichment (nickname, avatar, country).
# Linking works without it. Obtain it yourself at
# https://steamcommunity.com/dev/apikey — it is never requested in the app.
STEAM_WEB_API_KEY=
